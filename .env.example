# Local-only values. Replace secrets before exposing a deployment.
JWT_SECRET=replace-with-random-local-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-local-admin-password
DB_PASSWORD=ticket
MARIADB_ROOT_PASSWORD=replace-with-local-root-password

# Host ports. verify-clean-clone chooses free ports in its temporary clone.
PORT=8080
DB_HOST_PORT=3306

# App pool and timeout settings (optional; defaults shown).
DB_POOL_MAX_OPEN=100
DB_POOL_MAX_IDLE=50
DB_CONNECTION_LIMIT=400
DB_CONN_MAX_LIFETIME=5m
DB_STATEMENT_TIMEOUT=5s
DB_ACQUIRE_TIMEOUT=30s
REQUEST_TIMEOUT=60s
READY_TIMEOUT=2s
DB_STARTUP_TIMEOUT=5s

# Integration test connection defaults when using Docker Compose locally.
DB_USER=ticket
DB_NAME=tickets
DB_HOST=127.0.0.1:3306
